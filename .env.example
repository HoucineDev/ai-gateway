AIGW_ROLE=all
AIGW_DATABASE_URL=postgresql+asyncpg://aigw:aigw@localhost:5432/aigw
AIGW_VALKEY_URL=redis://localhost:6379/0
AIGW_ADMIN_KEY=change-me-admin
# Keycloak bearer tokens on the control API (docs/spec/01 §3.1); realm roles aigw-admin / aigw-operator / aigw-viewer
#AIGW_OIDC_ISSUER=https://keycloak.example.com/realms/aigw
#AIGW_OIDC_AUDIENCE=aigw-portal
# worker active health checks (docs/spec/04 §6): 0 disables
#AIGW_HEALTH_CHECK_INTERVAL_SECONDS=30
#AIGW_OIDC_ROLE_SCOPES={"aigw-admin":["*"],"aigw-viewer":["*:read"]}
# provider credentials referenced by deployments as credential_ref: "env:NAME"
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
